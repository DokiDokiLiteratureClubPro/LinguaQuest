# Copie ce fichier en `.env.local` et remplis les valeurs (voir README).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé "publishable" (sb_publishable_...) ou ancienne clé "anon" : les deux fonctionnent.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase > bouton "Connect" > "Transaction pooler" (port 6543)
# Remplace [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# URL publique du site (utilisée dans les e-mails de confirmation / mot de passe oublié)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
